<!--

    Spawning a statechart inside a statechart.

    A statechart can invoke another as a child. NestedOwner spawns an
    inner chart whose XML document is carried inline in a CDATA section,
    while src_list loads the extra Prolog fact child_value(ok) into the
    child's private module. The child is named inner_chart and monitored;
    trace(false) silences only the child's own trace, leaving the outer
    chart's lifecycle visible. On entry the child reads child_value(ok)
    and sends output(nested(ok)) to its parent, which arrives as
    output(ChildPid, nested(ok)); the outer chart matches that and prints
    nested(ok). It also receives spawned(Pid), sends that pid the finish
    event, and waits for the monitored notification down(Pid, Ref, Reason)
    before entering Final.

    Run the chart from the Examples menu.
    Keep the Logger open and SXML trace selected.

-->

<statechart version="0.2" initial="NestedOwner">
    <state id="NestedOwner" initial="Start">
        <spawn type="statechart"
               options="[monitor(true), name(inner_chart), trace(false), src_list([child_value(ok)])]"><![CDATA[
            <statechart version="0.2" initial="Waiting">
                <state id="Waiting">
                    <onentry>child_value(Value), output(nested(Value))</onentry>
                    <go to="Finished" on="finish" />
                </state>
                <final id="Finished" />
            </statechart>
        ]]></spawn>
        <state id="Start">
            <go to="WaitingForChild" on="spawned(Pid)">
                send(Pid, finish)
            </go>
        </state>
        <state id="WaitingForChild">
            <go on="output(_, nested(Value))">
                writeln(nested(Value))
            </go>
            <go to="Final" on="down(_, _, _)" />
        </state>
    </state>
    <final id="Final" />
</statechart>


