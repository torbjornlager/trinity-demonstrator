<!--

    Spaghetti: transition selection in a deeply nested chart.

    A deliberately tangled hierarchy (the classic statechart torture
    test), with states nested three deep and transitions on the events a
    through h criss-crossing between levels. Its purpose is to exercise
    the rules that decide, for a given event, which transition fires and
    exactly which states are exited and entered on the way. Send the
    events in different orders and follow the trace as the active
    configuration moves through the tree; event h reaches the final
    state f.

    Run the chart and send it events from the Examples menu.
    Keep the Logger open and SXML trace selected.

-->

<statechart version="0.2" initial="s0">
    <state id="s0" initial="s1">
        <state id="s1" initial="s11">
            <state id="s11">
                <go to="s211" on="g" />
            </state>
            <go to="s1" on="a" />
            <go to="s11" on="b" />
            <go to="s2" on="c" />
            <go to="s0" on="d" />
            <go to="s211" on="f" />
        </state>
        <state id="s2" initial="s21">
            <state id="s21" initial="s211">
                <state id="s211">
                    <go to="s21" on="d" />
                    <go to="s0" on="g" />
                    <go to="f" on="h" />
                </state>
                <go to="s211" on="b" />
            </state>
            <go to="s1" on="c" />
            <go to="s11" on="f" />
        </state>
        <go to="s211" on="e" />
    </state>
    <final id="f" />
</statechart>


