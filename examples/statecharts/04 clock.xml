<!--

    A clock ticking - and a state parallel to it that is listening.

    Run the chart from the Examples menu.
    Keep the Logger open and SXML trace selected.

-->

<statechart version="0.2" initial="Start">
    <parallel id="Start">
        <state id="Clock">
            <onentry>
                raise(tick)
            </onentry>
            <go on="tick">
                sleep(1),
                raise(tick)
            </go>
        </state>
        <state id="Listener">
            <go on="tick">
                writeln('Heard a tick!')
            </go>
        </state>
    </parallel>
</statechart>


