<!--

    Spawning a supervisor from a statechart.

    Another reusable behaviour started through <spawn>: a supervisor that
    owns and restarts child actors. Its one static child is a worker
    running sleep(60), declared temporary so it is never restarted once
    it exits, though the one_for_all strategy and a restart intensity of
    at most two restarts in five seconds are configured to show the form.
    The supervisor is registered as example_supervisor; after spawned(Pid)
    the chart asks that name for its current child counts and prints them,
    then raises done and enters Final. Leaving SupervisorOwner terminates
    the supervisor and its still-running worker as ordinary state-exit
    cleanup.

    Run the chart from the Examples menu.
    Keep the Logger open and SXML trace selected.

-->

<statechart version="0.2" initial="SupervisorOwner">
    <state id="SupervisorOwner" initial="Start">
        <spawn type="supervisor"
               children="[child(worker, [start(sleep(60)), restart(temporary)])]"
               options="[name(example_supervisor), strategy(one_for_all), intensity(2), period(5)]" />
        <state id="Start">
            <go to="Inspect" on="spawned(_)" />
        </state>
        <state id="Inspect">
            <onentry>
                supervisor_count_children(example_supervisor, Counts),
                writeln(Counts),
                raise(done)
            </onentry>
            <go to="Final" on="done" />
        </state>
    </state>
    <final id="Final" />
</statechart>


