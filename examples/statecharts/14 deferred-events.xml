<!--

    Postponing commands until the statechart is ready to handle them.

    Send two command/1 events while the machine is initialising.  They
    match <defer> and are kept in arrival order.  Sending initialised
    changes the active state to ready, where both commands are re-offered
    before a newer external event is accepted.

    Run the chart and send it events from the Examples menu.
    Keep the Logger open and SXML trace selected.

-->

<statechart version="0.2" initial="initialising">
    <state id="initialising">
        <onentry>
            writeln('Initialising...')
        </onentry>
        <defer on="command(_)"/>
        <go to="ready" on="initialised"/>
    </state>

    <state id="ready">
        <onentry>
            writeln('Ready.')
        </onentry>
        <go on="command(Command)">
            format('Performing ~p.~n', [Command])
        </go>
    </state>
</statechart>


