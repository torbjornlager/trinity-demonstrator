<!--

    Ping-pong between two parallel regions.

    The statechart cousin of the ping-pong actor example. Two orthogonal
    regions, Pinger and Ponger, rally by raising internal events at each
    other: Pinger serves by raising `ping` on entry; each `ping` prints,
    waits a second, and raises `pong`; each `pong` prints, waits, and
    raises `ping` again. The volley is driven entirely by internal events
    crossing between the two regions, with no external input.

    Run the chart from the Examples menu.
    Keep the Logger open and SXML trace selected.

-->

<statechart version="0.2" initial="Start">
    <parallel id="Start">
        <state id="Pinger">
            <onentry>
                raise(ping)
            </onentry>
            <go on="ping">
                writeln('Ping'),
                sleep(1),
                raise(pong)
            </go>
        </state>
        <state id="Ponger">
            <go on="pong">
                writeln('Pong'),
                sleep(1),
                raise(ping)
            </go>
        </state>
    </parallel>
</statechart>


