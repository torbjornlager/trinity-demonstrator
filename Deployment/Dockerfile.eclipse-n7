# syntax=docker/dockerfile:1
FROM debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc

# Supply the reviewed Linux ARM64 archive locally. The image contains the
# extracted runtime and its notices, without the archive in a build layer.
RUN --mount=type=bind,from=eclipse_dist,source=eclipse_basic.tgz,target=/tmp/eclipse_basic.tgz \
    echo '7599e154cca23b5601ed133df2f0481c43baf115b8cd6d7757795729d815e0d5  /tmp/eclipse_basic.tgz' | sha256sum -c - \
    && mkdir /eclipse \
    && tar --no-same-owner -xzf /tmp/eclipse_basic.tgz -C /eclipse \
    && test -x /eclipse/lib/aarch64_linux/eclipse.exe

WORKDIR /bridge
COPY experiments/eclipse-clp/actors.ecl experiments/eclipse-clp/solution_buffer.ecl \
     experiments/eclipse-clp/toplevel_actors.ecl experiments/eclipse-clp/isotope_bridge.ecl \
     experiments/eclipse-clp/isotope_rpc.ecl experiments/eclipse-clp/stateless_rpc.ecl ./
ENV ECLIPSEDIR=/eclipse LD_LIBRARY_PATH=/eclipse/lib/aarch64_linux HOME=/tmp
USER 65532:65532
ENTRYPOINT ["/eclipse/lib/aarch64_linux/eclipse.exe", "-D", "/eclipse", "-b", "isotope_bridge.ecl", "-e", "isotope_bridge:run"]
