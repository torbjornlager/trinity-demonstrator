{$N7_STAGE_ORIGIN} {
	{$N7_STAGE_TLS_DIRECTIVE}
	header {
		Cache-Control "no-store"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}

	@stateless {
		method GET
		path /call /node_info
	}
	handle @stateless {
		reverse_proxy {$N7_STAGE_HTTP_UPSTREAM:host.docker.internal:18097} {
			header_up -Cookie
			header_up -Authorization
			header_up -X-Auth-Request-User
			header_up -X-Auth-Request-Email
			header_up X-Web-Prolog-User n7-stateless-staging
			header_up X-Web-Prolog-Proxy-Token {$N7_STAGE_PROXY_TOKEN}
			header_up X-Web-Prolog-Client-IP {remote_host}
		}
	}

	respond "Not found" 404
}
