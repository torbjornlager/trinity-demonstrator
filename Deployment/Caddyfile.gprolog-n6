# GNU Prolog service. The adapter chooses owner-only or qualified public execution.
n6.elfenbenstornet.se {
    @legacy_portal path /portal /portal/
    redir @legacy_portal /demonstrator?{query} 308
    encode zstd gzip
    import cors_headers
    @options method OPTIONS
    handle @options {
        respond 204
    }
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        -Server
    }
    reverse_proxy n6_admission:8080 {
        import common_proxy_headers
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
    }
}

# Container-only metadata probe for the hub; no host port or execution route.
http://:8086 {
    @metadata {
        method GET
        path /node_info /version /healthz /readyz
    }
    handle @metadata {
        reverse_proxy n6_admission:8080 {
            import common_proxy_headers
            header_up Host n6.elfenbenstornet.se
            header_up -Authorization
            header_up -Cookie
            header_up X-Real-IP {remote_host}
        }
    }
    respond "Not found" 404
}
