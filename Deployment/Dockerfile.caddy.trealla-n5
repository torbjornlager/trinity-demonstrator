FROM caddy:2@sha256:36c24ad91a7ff7bc4c87fe22bfa8df3c4b18da0773d73fc12ee2c52b98c0bb7e

# Reuse the normal multi-node configuration through the start of N4, then
# replace only its trailing N5 site block. This keeps the default Caddy image
# and configuration intact for rollback.
COPY Deployment/Caddyfile /tmp/Caddyfile.base
COPY Deployment/Caddyfile.trealla-n5 /tmp/Caddyfile.trealla-n5
RUN sed '/^# n5:/,$d' /tmp/Caddyfile.base > /etc/caddy/Caddyfile \
    && cat /tmp/Caddyfile.trealla-n5 >> /etc/caddy/Caddyfile \
    && caddy validate --config /etc/caddy/Caddyfile
