# syntax=docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
# Consumer packaging: both upstream sources come from the dependency manifest.
FROM debian:bookworm-slim@sha256:99c0b25c46d0214d5a2091092e7908907dcaecd6a962cde0ac700acee222b6f3 AS trealla-build
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git python3 make gcc libc6-dev libssl-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY dependencies/trealla-port.json dependencies/trealla-port.json
COPY tools/pinned_trealla.py tools/fetch_trealla.py tools/
RUN --mount=type=secret,id=github_token \
    python3 tools/fetch_trealla.py \
      --port-destination /src/trealla-port --engine-destination /src/trealla \
      --token-file /run/secrets/github_token
RUN make -C /src/trealla -j"$(nproc)" NOFFI=1 NOTTY=1 \
    && python3 tools/pinned_trealla.py --engine-binary /src/trealla/tpl \
    && git -C /src/trealla-port archive HEAD --output=/port-source.tar \
    && mkdir /port-app \
    && tar -xf /port-source.tar -C /port-app

FROM debian:bookworm-slim@sha256:99c0b25c46d0214d5a2091092e7908907dcaecd6a962cde0ac700acee222b6f3
LABEL org.opencontainers.image.title="Pinned Trealla Web Prolog node" \
      org.opencontainers.image.source="https://github.com/torbjornlager/trealla-port" \
      org.opencontainers.image.licenses="MIT"
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libssl3 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 webprolog \
    && useradd --uid 10001 --gid webprolog --create-home webprolog \
    && mkdir -p /app /opt/trealla/library /state \
    && chown webprolog:webprolog /state
COPY --from=trealla-build /src/trealla/tpl /opt/trealla/tpl
COPY --from=trealla-build /src/trealla/library/ /opt/trealla/library/
COPY --from=trealla-build /src/trealla/LICENSE /src/trealla/ATTRIBUTION /usr/share/doc/trealla/
COPY --from=trealla-build /build/dependencies/trealla-port.json /usr/share/doc/trealla/runtime-pins.json
COPY --from=trealla-build --chown=webprolog:webprolog /port-app/ /app/
WORKDIR /app
ENV TPL_LIBRARY_PATH=/opt/trealla/library \
    TPL=/opt/trealla/tpl \
    HOME=/home/webprolog \
    WP_PORT=3060
RUN chmod 0755 /app/Deployment/entrypoint.sh \
    && WP_ADMIN_TOKEN=build-check-token-000000000000 /opt/trealla/tpl -g \
       "(catch((use_module('/app/Deployment/start_node.pl'),deployment_start:check_config),E,(writeq(E),nl,fail))->halt(0);halt(1))"
USER webprolog
EXPOSE 3060
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD /opt/trealla/tpl -g "use_module(library(http)),catch((http_open('http://127.0.0.1:${WP_PORT:-3060}/healthz',S,[timeout(3)]),close(S)),_,halt(1)),halt"
ENTRYPOINT ["/app/Deployment/entrypoint.sh"]
