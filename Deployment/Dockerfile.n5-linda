# syntax=docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
# The named context is built from manifest-pinned sources by Compose.
FROM trealla_runtime
COPY examples/services/linda_space.pl examples/services/linda_client.pl examples/services/linda_service_trealla.pl /app/owner_services/
COPY Deployment/start_n5_linda.pl Deployment/entrypoint.n5-linda.sh Deployment/shared_db_linda.pl /app/owner_start/
RUN /opt/trealla/tpl -g "use_module('/app/owner_start/start_n5_linda.pl'),halt"
ENTRYPOINT ["/bin/sh", "/app/owner_start/entrypoint.n5-linda.sh"]
