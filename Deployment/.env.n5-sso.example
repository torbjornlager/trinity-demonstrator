# ── n5 SSO (oauth2_n5) ──────────────────────────────────────────────
# GitHub OAuth config for the n5 web-prolog node's oauth2-proxy sidecar.
# COPY THESE LINES INTO Deployment/.env (which is git-ignored) and fill
# them in — do NOT commit real secrets. They are read by compose.yaml's
# oauth2_n5 service.
#
# Register an OAuth app at your provider with the callback URL:
#     https://n5.elfenbenstornet.se/oauth2/callback

# OAuth app credentials from the provider.
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=

# Cookie signing/encryption key — 32 random bytes, base64:
#     openssl rand -base64 32
OAUTH2_PROXY_COOKIE_SECRET=

# ── Owner identity (both values are mandatory) ─────────────────────
# Exactly one GitHub login; oauth2-proxy rejects every other account.
OAUTH2_PROXY_GITHUB_USERS=your-github-login
# The verified email oauth2-proxy supplies for that account. N5 grants
# capabilities only to this principal; all other authenticated users are
# denied by the empty authenticated-default tier.
WP_N5_OWNER=your-verified-github-email@example.com

# ── n5 node tuning (optional; all have safe defaults in compose.yaml) ──
# WP_N5_PROFILE=actor
# WP_N5_SANDBOX=blacklist          # default (playground); whitelist = stricter
# WP_N5_MAX_ACTORS=10000
# WP_N5_MAX_CALL_INFERENCES=1000000000
# WP_N5_MAX_ACTOR_STACK_BYTES=268435456
